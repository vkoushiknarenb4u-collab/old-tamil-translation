# Gemini API. Keep this server-only; never prefix with NEXT_PUBLIC_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Optional File Search store name, e.g. fileSearchStores/abc123
GEMINI_FILE_SEARCH_STORE_ID=

# Supabase project settings (service role key is server-only)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=inscription-archive

# Protects all /api/admin/* endpoints. Use a long random value.
ADMIN_TOKEN=
